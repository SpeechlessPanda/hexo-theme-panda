nav#nav
  span#blog-info
    a.nav-site-title(href=url_for(globalPageType === 'post' ? postListingPath() : '/'))
      if theme.nav.logo
        img.site-icon(src=url_for(theme.nav.logo) alt='Logo')
      if theme.nav.display_title
        span.site-name=config.title
    if globalPageType === 'post' && theme.nav.display_post_title
      a.nav-page-title(href=url_for(postListingPath()))
        span.site-name=(page.title || config.title)
        span.site-name
          i.fa-solid.fa-circle-arrow-left
          span= '  ' + _p('post.back_to_home')

  #menus
    if theme.search.use
      #search-button
        button.site-page.social-icon.search(type="button" aria-label=_p('search.title'))
          i.fas.fa-search.fa-fw(aria-hidden="true")
          span= ' ' + _p('search.title')
    if theme.menu
      != partial('includes/header/menu_item', {}, {cache: true})

      #toggle-menu
        button.site-page(type="button" aria-label=_p('nav.menu') aria-controls="sidebar-menus" aria-haspopup="dialog" aria-expanded="false")
          i.fas.fa-bars.fa-fw(aria-hidden="true")