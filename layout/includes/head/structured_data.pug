if theme.structured_data && theme.structured_data.enable
  - let jsonLd
  if page.layout === 'post'
    -
      // https://developers.google.com/search/docs/appearance/structured-data/article

      const title = page.title
      const url = page.permalink
      const imageVal = page.cover_type === 'img' ? page.cover : theme.avatar.img
      const image = imageVal ? full_url_for(imageVal) : ''
      const datePublished = page.date.toISOString()
      const dateModified = postUpdated(page).toISOString()
      const author = page.copyright_author || config.author
      const authorHrefVal = page.copyright_author_href || theme.post_copyright.author_href || config.url
      const authorHref = full_url_for(authorHrefVal)

      jsonLd = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "url": url,
        "image": image,
        "datePublished": datePublished,
        "dateModified": dateModified,
        "author": [{
          "@type": "Person",
          "name": author,
          "url": authorHref
        }]
      }
    -

  else if is_home() && (!page.current || page.current === 1)
    -
      // https://developers.google.com/search/docs/appearance/site-names#website
      // The home page is the only page that may describe the site, but a site can
      // live under a sub-path (`root: /blog/`): `url_for('/')` is then `/blog/`, so
      // testing it for `/` silently dropped the block for every such site.

      const siteUrl = full_url_for('/')
      const domain = new URL(siteUrl).hostname
      const alternateNames = [...(theme.structured_data.alternate_name || [])]
      if (config.subtitle) alternateNames.push(config.subtitle)

      if (domain) {
        alternateNames.push(domain)
      }

      jsonLd = {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": config.title,
        "alternateName": alternateNames,
        "url": siteUrl,
      }
    -

  if jsonLd
    script(type="application/ld+json")!= safeJSON(jsonLd)
