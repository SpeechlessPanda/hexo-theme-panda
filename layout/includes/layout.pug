- var navBandClass = theme.background && !Array.isArray(theme.background) && bgImageUrl(theme.background) ? 'panda-nav-band' : ''

doctype html
html(lang=config.language data-theme=theme.display_mode class=[htmlClassHideAside, navBandClass])
  head
    include ./head.pug
  body
    !=partial('includes/loading/index', {}, {cache: true})

    if theme.background
      if !Array.isArray(theme.background)
        #web_bg.bg-animation(style=getBgPath(theme.background))
      else
        #web_bg.bg-animation
        - const bgStyleArr = theme.background.map(getBgPath)
        - const bgImgArr = theme.background.map(item => {
        -   const imgUrl = bgImageUrl(item)
        -   return imgUrl ? `url('${imgUrl}')` : null
        - })
        script.
          (() => {
            const arr = !{JSON.stringify(bgStyleArr)}
            const imgs = !{JSON.stringify(bgImgArr)}
            const webBgDiv = document.getElementById('web_bg')
            const root = document.documentElement

            const setRandomBg = () => {
              const index = Math.floor(Math.random() * arr.length)
              webBgDiv.style = arr[index]
              // Panda: keep the fixed nav band on the same image as #web_bg
              const img = imgs[index]
              if (img) {
                root.classList.add('panda-nav-band')
                root.style.setProperty('--panda-nav-bg-image', img)
              } else {
                root.classList.remove('panda-nav-band')
                root.style.removeProperty('--panda-nav-bg-image')
              }
              requestAnimationFrame(() => webBgDiv.classList.add('bg-animation'))
            }

            const clearBg = () => {
              webBgDiv.style = ''
              webBgDiv.classList.remove('bg-animation')
              root.classList.remove('panda-nav-band')
              root.style.removeProperty('--panda-nav-bg-image')
            }

            document.addEventListener('pjax:send', clearBg)
            document.addEventListener('pjax:complete', setRandomBg)
            document.addEventListener('DOMContentLoaded', setRandomBg)
          })()

    !=partial('includes/sidebar', {}, {cache: true})

    #body-wrap(class=pageType)
      include ./header/index.pug

      main#content-inner.layout(class=hideAside)
        if body
          div!= body
        else
          block content
          if theme.aside.enable && page.aside !== false
