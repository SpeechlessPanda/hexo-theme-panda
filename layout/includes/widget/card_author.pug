//- Modified from hexo-theme-butterfly 5.7.0 (Apache-2.0) by SpeechlessPanda, 2026: removes categories count from the author card
if theme.aside.card_author.enable
  .card-widget.card-info.text-center
    .avatar-img
      img(src=url_for(theme.avatar.img) onerror=`this.onerror=null;this.src='` + url_for(theme.error_img.flink) + `'` alt="avatar")
    .author-info-name= config.author
    .author-info-description!= theme.aside.card_author.description || config.description

    .site-data
      a(href=url_for(config.archive_dir) + '/')
        .headline= _p('aside.articles')
        .length-num= site.posts.length
      a(href=url_for(config.tag_dir) + '/')
        .headline= _p('aside.tags')
        .length-num= site.tags.length

    if theme.aside.card_author.button.enable
      a#card-info-btn(href=theme.aside.card_author.button.link)
        i(class=theme.aside.card_author.button.icon)
        span=theme.aside.card_author.button.text

    //- The social row holds GitHub / Email / RSS and, when enabled, the AI reading
    //- entry appended after them. `social` alone does not decide: a site with no
    //- social links still gets the robot here. social.pug drops the empty row.
    if theme.social || (theme.ai_readable && theme.ai_readable.enable && theme.ai_readable.portal && theme.ai_readable.portal.enable && theme.ai_readable.portal.social_icon && theme.ai_readable.portal.social_icon.enable && theme.ai_readable.portal.social_icon.show_in_author_card !== false)
      .card-info-social-icons
        !=partial('includes/header/social', {}, {cache: true})
