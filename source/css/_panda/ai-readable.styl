//- Panda theme — AI reading portal and copyright policy styles (Apache-2.0).
//- Reuses the theme's card surface, radius and colour variables so both pages look
//- native in light and dark mode without a second design language.
.ai-portal,
.rights-page
  .ai-portal-hero,
  .rights-hero
    padding: 1.6rem 1.8rem
    margin-bottom: 1.2rem
    addBorderRadius(12)
    background: var(--card-bg)
    box-shadow: 0 4px 18px rgba(38, 79, 126, 0.08)
    background-image: linear-gradient(135deg, rgba(79, 172, 254, 0.10) 0%, rgba(161, 140, 209, 0.10) 55%, rgba(255, 210, 168, 0.10) 100%)

    &__title
      margin: 0 0 0.6rem
      font-size: 1.6em

    &__intro,
    &__bio
      margin: 0.4rem 0
      color: var(--font-color)
      opacity: 0.9

    &__site
      margin: 0
      color: var(--theme-meta-color)

  .ai-portal-section,
  .rights-section
    padding: 1.3rem 1.6rem
    margin-bottom: 1rem
    addBorderRadius(12)
    background: var(--card-bg)
    box-shadow: 0 2px 12px rgba(38, 79, 126, 0.06)

    h2
      margin-top: 0
      font-size: 1.2em
      padding-left: 0.6rem
      border-left: 3px solid var(--theme-color)

  .ai-portal-topics
    display: flex
    flex-wrap: wrap
    gap: 0.5rem
    margin: 0.8rem 0 0
    padding: 0
    list-style: none

    li
      padding: 0.2rem 0.7rem
      font-size: 0.9em
      addBorderRadius(999px)
      background: rgba(79, 172, 254, 0.12)
      color: var(--theme-color)

      //- A curated topic ships a one-line description; it sits after the name,
      //- dimmed, and wraps rather than stretching the chip.
      .ai-portal-topic__note
        display: block
        margin-top: 0.1rem
        font-size: 0.92em
        color: var(--card-meta)
        font-weight: normal

  .ai-portal-list
    margin: 0
    padding-left: 1.1rem

  .ai-portal-item
    margin-bottom: 0.9rem

    &__title
      font-weight: 600

    &__date
      margin-left: 0.6rem
      font-size: 0.85em
      color: var(--theme-meta-color)

    &__desc
      margin: 0.2rem 0 0
      font-size: 0.92em
      color: var(--theme-meta-color)

    &__md
      display: inline-block
      margin-left: 0.6rem
      padding: 0 0.45rem
      font-size: 0.78em
      line-height: 1.6
      addBorderRadius(4)
      border: 1px solid var(--theme-color)
      color: var(--theme-color)
      text-decoration: none

      &:hover
        background: var(--theme-color)
        color: #fff

  .ai-portal-series
    margin-bottom: 1rem

    &__title
      font-weight: 600

    &__desc
      margin: 0.2rem 0 0.4rem
      font-size: 0.92em
      color: var(--theme-meta-color)

    &__members
      margin: 0
      padding-left: 1.3rem

  .rights-note
    font-size: 0.88em
    color: var(--theme-meta-color)

  +maxWidth768()
    .ai-portal-hero,
    .rights-hero
      padding: 1.2rem 1rem

    .ai-portal-section,
    .rights-section
      padding: 1rem

[data-theme='dark']
  .ai-portal,
  .rights-page
    .ai-portal-hero,
    .rights-hero,
    .ai-portal-section,
    .rights-section
      box-shadow: 0 2px 14px rgba(0, 0, 0, 0.35)
      background-image: linear-gradient(135deg, rgba(79, 172, 254, 0.08) 0%, rgba(161, 140, 209, 0.10) 55%, rgba(157, 78, 221, 0.08) 100%)

    .ai-portal-topics li
      background: rgba(161, 140, 209, 0.18)

//- Home "Follow Me" row: the same icons as the author card, directly under the
//- about content, so the AI reading entry exists even when the aside is off.
.panda-follow-me
  display: flex
  flex-wrap: wrap
  align-items: center
  justify-content: center
  gap: 0.4rem 0.8rem
  margin-top: 1.6rem
  padding-top: 1.2rem
  border-top: 1px dashed var(--border-color, rgba(153, 169, 191, 0.35))

  &__label
    font-size: 0.9em
    color: var(--theme-meta-color)

  &__icons
    margin: 0

    .social-icon
      margin: 0 8px
      color: var(--font-color)
      font-size: 1.35em

      &:hover
        color: var(--theme-color)

  +maxWidth768()
    margin-top: 1.2rem

.social-icon.ai-reading-icon
  i
    transition: all .3s

  &:hover i
    transform: rotate(360deg)
