// New file in hexo-theme-panda (Apache-2.0), forked from hexo-theme-butterfly 5.7.0: Panda-specific fixes

// Fix X/Twitter share icon visibility (icon-x is dark-on-dark without this)
.social-share .icon-x
  color: #ffffff !important
  border-color: rgba(255, 255, 255, 0.85) !important

  &:hover
    background: #000000 !important
    color: #ffffff !important

[data-theme='dark'] .social-share .icon-x
  color: #ffffff !important
  border-color: rgba(255, 255, 255, 0.7) !important

  &:hover
    background: rgba(255, 255, 255, 0.9) !important
    color: #000000 !important

.post-series-link
  display: inline-flex
  align-items: center
  gap: 0.35em
  margin: 0.4em 0 0
  font-size: 0.85em
  opacity: 0.92

  i
    margin-right: 0.15em

.recent-post-item.series-card .article-title .series-badge
  margin-right: 0.4em
  font-size: 0.85em
  opacity: 0.8
