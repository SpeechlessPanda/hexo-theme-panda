html:has(#sidebar-menus[open], .code-fullpage-dialog[open])
  overflow: hidden

#sidebar
  #sidebar-menus
    position: fixed
    inset: 0 0 0 auto
    overflow-x: hidden
    overflow-y: auto
    overscroll-behavior: contain
    margin: 0
    padding-left: 5px
    width: $sidebar-width
    height: 100%
    max-height: none
    border: 0
    background: var(--sidebar-bg)
    color: var(--font-color)

    &::backdrop
      background: alpha($dark-black, .8)

    .drawer-close
      display: block
      margin-left: auto
      padding: .15em .6em
      border: 0
      background: none
      color: inherit
      font-size: 1.5em
      cursor: pointer

    & > .avatar-img
      margin: 20px auto

    .site-data
      padding: 0 10px

    hr
      margin: 20px auto

    .menus_items
      margin: 20px
      padding: 15px
      background: var(--sidebar-menu-bg)
      box-shadow: 0 0 1px 1px rgba(7, 17, 27, .05)
      addBorderRadius(10)

      .site-page
        @extend .limit-one-line
        position: relative
        display: block
        margin: 4px 0
        padding: 2px 23px 2px 15px
        color: var(--font-color)
        font-size: 1.15em
        cursor: pointer
        addBorderRadius(6)

        &:hover
          background: var(--text-bg-hover)
          box-shadow: 0 2px 8px rgba(0, 0, 0, .1)
          color: var(--white)
          transition: all .2s ease
          transform: translateX(3px)

        i:first-child
          width: 15%
          text-align: left

        &.group
          width: 100%
          border: 0
          background: none
          text-align: left
          & > i:last-child
            position: absolute
            top: .6em
            right: 10px
            transition: transform .3s

          &.hide
            & > i:last-child
              transform: rotate(90deg)

            & + .menus_item_child
              overflow: hidden
              max-height: 0
              opacity: 0
              transform: scaleY(0)
              transform-origin: top

      .menus_item_child
        margin: 0
        padding-left: 25px
        max-height: 0
        visibility: hidden
        list-style: none
        opacity: 0
        transition: transform .3s ease, opacity .3s ease, max-height .3s ease
        transform: scaleY(0)
        transform-origin: top
        will-change: transform, opacity, max-height

    // 當父元素沒有 .hide 類時，顯示子目錄
    .site-page.group:not(.hide) + .menus_item_child
      visibility: visible
      max-height: 1000px
      opacity: 1
      transform: scaleY(1)